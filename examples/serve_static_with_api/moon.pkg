import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/stdio",
  "moonbitlang/moonback",
  "moonbitlang/moonback/middlewares/unstable_static",
  "moonbitlang/moonback/middlewares/unstable_logreq",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/stdio",
  ],
)
